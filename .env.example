# Required at BUILD time as well as runtime — see DEPLOY.md.
NUXT_PUBLIC_SITE_URL=https://your-domain.com

# Database
NUXT_MONGO_URI=mongodb://localhost:27017/portfolio

# Email (Phase 3 — the contact endpoint moves here from portfolio_back)
NUXT_RESEND_API_KEY=
NUXT_MAIL_FROM=Portfolio <contact@your-domain.com>
NUXT_MAIL_TO=you@your-domain.com
NUXT_NOTIFY_WEBHOOK_URL=

# Admin — all three required for /admin to work; without them the public site still runs.
# Session cookie seal, at least 32 characters: openssl rand -base64 48
NUXT_SESSION_SECRET=
NUXT_ADMIN_EMAIL=you@your-domain.com
# printf '%s' 'your password' | npm run hash-password
NUXT_ADMIN_PASSWORD_HASH=

NUXT_MESSAGE_RATE_LIMIT_HOURS=24

# Preproduction only — both must be set for HTTP basic auth to activate.
# Leave unset in production; the middleware is then inert.
NUXT_BASIC_AUTH_USER=
NUXT_BASIC_AUTH_PASSWORD=
